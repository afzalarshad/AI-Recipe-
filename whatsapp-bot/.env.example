# Server port
PORT=4100

# Anthropic API key, used to answer recipe questions grounded in the Kun Foods
# recipe data. Leave unset to run in offline mock mode (returns the best-matching
# recipe's ingredients/steps directly, without an LLM-written answer).
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta) credentials. Leave unset to keep the bot inactive
# (sendWhatsAppText becomes a no-op); POST /whatsapp/test-query still works
# without these for local testing of the recipe Q&A logic.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — must match what you enter in the Meta webhook setup form.
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app, used to verify incoming webhook signatures.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0

# OpenAI API key, used only to transcribe incoming WhatsApp voice notes (Whisper).
# Leave unset and the bot will ask voice-note senders to type their question instead.
OPENAI_API_KEY=
