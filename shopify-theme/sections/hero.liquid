<section class="hero hero--{{ section.settings.height }}" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1920x', class: 'hero__video' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', class: 'hero__image' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder hero__image' }}
    {%- endif -%}
  </div>
  <div class="hero__content page-width hero__content--{{ section.settings.alignment }}">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="hero__heading h-display">{{ section.settings.heading }}</h1>
    {%- assign taglines = section.blocks | where: 'type', 'tagline' -%}
    {%- if taglines.size > 0 -%}
      <rotating-text class="hero__ticker" data-interval="{{ section.settings.interval | times: 1000 }}">
        {%- for block in taglines -%}
          <span class="hero__tagline{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- endfor -%}
      </rotating-text>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button button--large" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "max_blocks": 6,
  "settings": [
    { "type": "video", "id": "video", "label": "Background video", "info": "Short, muted, looping clip works best. Shown instead of the image." },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "select", "id": "height", "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select", "id": "alignment", "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "overlay", "label": "Image darkening", "unit": "%", "min": 0, "max": 80, "step": 5, "default": 35 },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Kun Foods" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Pakistani flavour, ready in minutes" },
    { "type": "range", "id": "interval", "label": "Tagline change speed", "unit": "s", "min": 2, "max": 8, "step": 1, "default": 3 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "tagline",
      "name": "Rotating tagline",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Ghar jaisa zaiqa." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "tagline", "settings": { "text": "Ghar jaisa zaiqa." } },
        { "type": "tagline", "settings": { "text": "No preservatives. Just real spices." } },
        { "type": "tagline", "settings": { "text": "Dinner sorted in 20 minutes." } }
      ]
    }
  ]
}
{% endschema %}
