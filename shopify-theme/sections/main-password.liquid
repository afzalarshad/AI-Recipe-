<section class="section password">
  <div class="page-width page-width--narrow text-center">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, class: 'password__logo' }}
    {%- else -%}
      <p class="header__wordmark">{{ shop.name }}</p>
    {%- endif -%}
    <h1 class="h1">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="field-row">
          <label class="visually-hidden" for="PwNewsletter">{{ 'newsletter.email' | t }}</label>
          <input class="input" id="PwNewsletter" type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}">
          <button class="button" type="submit">{{ 'newsletter.subscribe' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="link">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="field-row">
          <label class="visually-hidden" for="StorePassword">{{ 'customer.password' | t }}</label>
          <input class="input" type="password" id="StorePassword" name="password" autocomplete="current-password" placeholder="{{ 'customer.password' | t }}">
          <button class="button" type="submit">{{ 'customer.submit' | t }}</button>
        </div>
      {%- endform -%}
      <p><a class="link" href="/admin">{{ 'password.admin' | t }}</a></p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something tasty is coming" }
  ]
}
{% endschema %}
