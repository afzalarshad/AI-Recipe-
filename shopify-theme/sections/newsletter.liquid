<section class="section section--{{ section.settings.color_scheme }}">
  <div class="page-width newsletter">
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte newsletter__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- assign form_id = 'Newsletter-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-success" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="field-row">
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
          <input class="input" id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}">
          <button type="submit" class="button">{{ 'newsletter.subscribe' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form-error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "select", "id": "color_scheme", "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "White" },
        { "value": "accent", "label": "Accent" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "accent"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 15% off your first order" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Join the Kun Foods family for new recipes, launches and member-only offers.</p>" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
