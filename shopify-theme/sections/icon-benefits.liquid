<section class="section section--{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header"><h2 class="h2">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <ul class="benefits" style="--cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="benefit" {{ block.shopify_attributes }}>
          <span class="benefit__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3 class="benefit__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="benefit__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Icon benefits",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select", "id": "color_scheme", "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "White" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "flame", "label": "Flame" },
            { "value": "chili", "label": "Chili" },
            { "value": "clock", "label": "Clock" },
            { "value": "pot", "label": "Cooking pot" },
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "gift", "label": "Gift" },
            { "value": "chat", "label": "Chat" },
            { "value": "wheat-off", "label": "Gluten free" }
          ],
          "default": "clock"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Quick to cook" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "From pack to plate in about 20 minutes." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "clock", "title": "Quick to cook", "text": "From pack to plate in about 20 minutes." } },
        { "type": "benefit", "settings": { "icon": "leaf", "title": "Real ingredients", "text": "Whole spices, ground and blended. Nothing artificial." } },
        { "type": "benefit", "settings": { "icon": "chili", "title": "Authentic taste", "text": "Recipes perfected in Pakistani home kitchens." } },
        { "type": "benefit", "settings": { "icon": "chat", "title": "Recipe help", "text": "Message our WhatsApp bot for step-by-step recipes." } }
      ]
    }
  ]
}
{% endschema %}
