<section class="section section--{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow text-center">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select", "id": "color_scheme", "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "White" },
        { "value": "accent", "label": "Accent" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell customers where Kun Foods began and what makes your recipes special.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
