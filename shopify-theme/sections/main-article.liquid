<article class="section">
  <div class="page-width page-width--narrow">
    <a class="link" href="{{ blog.url }}">← {{ 'blogs.back' | t: title: blog.title }}</a>
    <h1 class="h1">{{ article.title }}</h1>
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
    {%- if article.image -%}
      <div class="article__image">
        {{ article.image | image_url: width: 1600 | image_tag: sizes: '(min-width: 800px) 760px, 100vw', widths: '600, 900, 1200, 1600', loading: 'eager' }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    {%- if section.settings.show_whatsapp and settings.social_whatsapp != blank -%}
      <a class="callout" href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener">
        {% render 'icon', name: 'whatsapp' %}
        <span>{{ section.settings.whatsapp_text }}</span>
      </a>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "checkbox", "id": "show_whatsapp", "label": "Show WhatsApp recipe bot link", "default": true, "info": "Uses the WhatsApp link from Theme settings → Social media." },
    { "type": "text", "id": "whatsapp_text", "label": "WhatsApp link text", "default": "Stuck on a step? Ask the Kun Foods recipe bot on WhatsApp." }
  ]
}
{% endschema %}
