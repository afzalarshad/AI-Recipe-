{%- assign blog = section.settings.blog -%}
<section class="section">
  <div class="page-width">
    <div class="section__header">
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <ul class="grid" style="--cols: 3;">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.limit -%}
          <li>{% render 'article-card', article: article %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li>
            <article class="article-card">
              <div class="article-card__media">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}</div>
              <p class="eyebrow">Main course · 30 min</p>
              <h3 class="article-card__title">Recipe title</h3>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if blog != blank -%}
      <div class="section__footer"><a class="button button--outline" href="{{ blog.url }}">{{ section.settings.view_all_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured recipes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cook with Kun Foods" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Create a blog called Recipes. Tag each post with its category, and add a minutes tag like 'time:30'." },
    { "type": "range", "id": "limit", "label": "Recipes to show", "min": 3, "max": 9, "step": 3, "default": 3 },
    { "type": "text", "id": "view_all_label", "label": "'View all' label", "default": "All recipes" }
  ],
  "presets": [ { "name": "Featured recipes" } ]
}
{% endschema %}
