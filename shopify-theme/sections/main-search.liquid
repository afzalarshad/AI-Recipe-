{%- paginate search.results by 24 -%}
<section class="section">
  <div class="page-width">
    <h1 class="h1">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="field-row search-form">
      <label class="visually-hidden" for="SearchInput">{{ 'search.title' | t }}</label>
      <input class="input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="button">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="empty">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <p class="section__sub">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
        <ul class="grid" style="--cols: 4;">
          {%- for item in search.results -%}
            <li>
              {%- case item.object_type -%}
                {%- when 'product' -%}{% render 'product-card', product: item %}
                {%- when 'article' -%}{% render 'article-card', article: item %}
                {%- else -%}
                  <article class="article-card">
                    <h3 class="article-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                  </article>
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Search results" }
{% endschema %}
