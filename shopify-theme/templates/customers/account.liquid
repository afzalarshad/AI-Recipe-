<section class="section">
  <div class="page-width">
    <div class="account-head">
      <h1 class="h1">{{ 'customer.account' | t }}</h1>
      <a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a>
    </div>
    <div class="account-grid">
      <div>
        <h2 class="h3">{{ 'customer.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="table">
              <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.payment' | t }}</th><th>{{ 'customer.fulfillment' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money_with_currency }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p>{{ 'customer.no_orders' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <div>
        <h2 class="h3">{{ 'customer.addresses' | t }}</h2>
        {{ customer.default_address | format_address }}
        <a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.view_addresses' | t: count: customer.addresses_count }}</a>
      </div>
    </div>
  </div>
</section>
