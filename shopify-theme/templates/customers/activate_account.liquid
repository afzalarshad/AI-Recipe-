<section class="section">
  <div class="page-width page-width--narrow form-page">
    <h1 class="h1">{{ 'customer.activate' | t }}</h1>
    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label class="label" for="ActPassword">{{ 'customer.password' | t }}</label><input class="input" type="password" id="ActPassword" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label class="label" for="ActConfirm">{{ 'customer.password_confirm' | t }}</label><input class="input" type="password" id="ActConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="button" type="submit">{{ 'customer.activate' | t }}</button>
      <button class="button button--outline" type="submit" name="decline">{{ 'customer.decline' | t }}</button>
    {%- endform -%}
  </div>
</section>
