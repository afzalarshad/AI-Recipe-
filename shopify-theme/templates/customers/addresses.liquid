<section class="section">
  <div class="page-width page-width--narrow form-page">
    <a class="link" href="{{ routes.account_url }}">← {{ 'customer.account' | t }}</a>
    <h1 class="h1">{{ 'customer.addresses' | t }}</h1>
    {%- paginate customer.addresses by 10 -%}
      {%- for address in customer.addresses -%}
        <div class="address-card">
          {%- if address == customer.default_address -%}<p class="badge">{{ 'customer.default' | t }}</p>{%- endif -%}
          {{ address | format_address }}
          <details>
            <summary class="link">{{ 'customer.edit' | t }}</summary>
            {%- form 'customer_address', address -%}
              {% render 'address-fields', form: form, id: address.id %}
              <button class="button" type="submit">{{ 'customer.submit' | t }}</button>
            {%- endform -%}
          </details>
          <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" onsubmit="return confirm('{{ 'customer.delete' | t }}?');">
            <input type="hidden" name="_method" value="delete">
            <button class="link" type="submit">{{ 'customer.delete' | t }}</button>
          </form>
        </div>
      {%- endfor -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
    <details class="address-card">
      <summary class="button button--outline">{{ 'customer.add_address' | t }}</summary>
      {%- form 'customer_address', customer.new_address -%}
        {% render 'address-fields', form: form, id: 'new' %}
        <button class="button" type="submit">{{ 'customer.submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>
