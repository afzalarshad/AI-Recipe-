<section class="section">
  <div class="page-width page-width--narrow form-page">
    <h1 class="h1">{{ 'customer.reset' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label class="label" for="ResetPassword">{{ 'customer.password' | t }}</label><input class="input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label class="label" for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label><input class="input" type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="button" type="submit">{{ 'customer.reset' | t }}</button>
    {%- endform -%}
  </div>
</section>
