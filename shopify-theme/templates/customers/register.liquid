<section class="section">
  <div class="page-width page-width--narrow form-page">
    <h1 class="h1">{{ 'customer.register' | t }}</h1>
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label class="label" for="RegFirst">{{ 'customer.first_name' | t }}</label><input class="input" id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field"><label class="label" for="RegLast">{{ 'customer.last_name' | t }}</label><input class="input" id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="field"><label class="label" for="RegEmail">{{ 'customer.email' | t }}</label><input class="input" type="email" id="RegEmail" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label class="label" for="RegPassword">{{ 'customer.password' | t }}</label><input class="input" type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required></div>
      <button class="button button--full" type="submit">{{ 'customer.register' | t }}</button>
    {%- endform -%}
  </div>
</section>
