[
  {
    "name": "theme_info",
    "theme_name": "Kun Foods",
    "theme_version": "1.0.0",
    "theme_author": "Kun Foods",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_background", "label": "Background", "default": "#FBF6EE" },
      { "type": "color", "id": "color_surface", "label": "Card / surface", "default": "#FFFFFF" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#221A14" },
      { "type": "color", "id": "color_accent", "label": "Accent (buttons, links)", "default": "#9E2B1B" },
      { "type": "color", "id": "color_accent_text", "label": "Text on accent", "default": "#FFFFFF" },
      { "type": "color", "id": "color_highlight", "label": "Highlight (badges, stars)", "default": "#E3A33B" },
      { "type": "color", "id": "color_dark", "label": "Dark band (announcement, footer)", "default": "#2A1D15" },
      { "type": "color", "id": "color_dark_text", "label": "Text on dark band", "default": "#FBF6EE" },
      { "type": "color", "id": "color_sale", "label": "Savings / sale", "default": "#2F6B3A" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "type_heading_font", "label": "Headings", "default": "assistant_n4" },
      { "type": "font_picker", "id": "type_body_font", "label": "Body", "default": "assistant_n4" },
      {
        "type": "range", "id": "heading_scale", "label": "Heading size", "unit": "%",
        "min": 80, "max": 140, "step": 5, "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range", "id": "page_width", "label": "Page width", "unit": "px",
        "min": 1000, "max": 1600, "step": 20, "default": 1320
      },
      {
        "type": "range", "id": "radius", "label": "Card corner radius", "unit": "px",
        "min": 0, "max": 24, "step": 2, "default": 12
      },
      {
        "type": "range", "id": "button_radius", "label": "Button corner radius", "unit": "px",
        "min": 0, "max": 40, "step": 2, "default": 40
      }
    ]
  },
  {
    "name": "Logo & favicon",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      {
        "type": "range", "id": "logo_width", "label": "Logo width", "unit": "px",
        "min": 60, "max": 260, "step": 10, "default": 140
      },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 x 32px PNG recommended" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select", "id": "cart_behavior", "label": "After adding to cart",
        "options": [
          { "value": "toast", "label": "Stay on page and show a notice" },
          { "value": "page", "label": "Go to the cart page" }
        ],
        "default": "toast"
      },
      {
        "type": "text", "id": "free_shipping_threshold", "label": "Free shipping threshold",
        "info": "Amount in your store currency, e.g. 5000. Shows a progress bar in the cart. Leave blank to hide."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_whatsapp", "label": "WhatsApp link", "info": "e.g. https://wa.me/923001234567 — links customers to the Kun Foods recipe bot" }
    ]
  }
]
