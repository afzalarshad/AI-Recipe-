{%- comment -%}
  Usage: {% render 'price', product: product, variant: variant, show_from: true %}
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  {%- if show_from and product.price_varies and variant == blank -%}
    <span class="price__current">{{ 'products.from' | t: price: product.price_min | money }}</span>
  {%- else -%}
    <span class="visually-hidden">{% if on_sale %}{{ 'products.sale_price' | t }}{% else %}{{ 'products.regular_price' | t }}{% endif %}</span>
    <span class="price__current" data-price>{{ price | money }}</span>
    {%- if on_sale -%}
      <s class="price__compare" data-compare>{{ compare | money }}</s>
    {%- endif -%}
  {%- endif -%}
</div>
