{%- comment -%}
  Renders an inline line icon.
  Usage: {% render 'icon', name: 'leaf' %}
{%- endcomment -%}
<svg class="icon icon--{{ name }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'leaf' -%}<path d="M5 19c8 0 14-6 14-14-8 0-14 6-14 14Z"/><path d="M5 19 13 11"/>
    {%- when 'flame' -%}<path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3-1-3 0-6 1-9Z"/>
    {%- when 'chili' -%}<path d="M16 6c-1 6-5 12-12 13 4-3 6-8 7-12 1-2 3-2 5-1Z"/><path d="M16 6c0-2 1-3 3-3"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
    {%- when 'shield' -%}<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10Z"/>
    {%- when 'check' -%}<path d="m5 12 4 4 10-10"/>
    {%- when 'star' -%}<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z" fill="currentColor" stroke="none"/>
    {%- when 'pot' -%}<path d="M4 10h16v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-5ZM2 10h20M9 6c0-1 1-1 1-2M14 6c0-1 1-1 1-2"/>
    {%- when 'wheat-off' -%}<path d="M12 21V10M12 10c-2 0-3-2-3-4 2 0 3 2 3 4Zm0 0c2 0 3-2 3-4-2 0-3 2-3 4ZM12 15c-2 0-3-2-3-3 2 0 3 1 3 3Zm0 0c2 0 3-2 3-3-2 0-3 1-3 3ZM4 4l16 16"/>
    {%- when 'globe' -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>
    {%- when 'gift' -%}<path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13M12 7c-2-4-6-3-5 0M12 7c2-4 6-3 5 0"/>
    {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4V5Z"/>
    {%- when 'cart' -%}<path d="M3 4h2l2.4 11h11L21 7H6.2"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/>
    {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
    {%- when 'menu' -%}<path d="M3 6h18M3 12h18M3 18h18"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'play' -%}<path d="M8 5v14l11-7L8 5Z" fill="currentColor"/>
    {%- when 'chevron' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'facebook' -%}<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v7h4v-7h3l1-4h-4V8Z"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>
    {%- when 'tiktok' -%}<path d="M14 3v11a4 4 0 1 1-4-4M14 3c0 3 2 5 5 5"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="m10 9 5 3-5 3V9Z" fill="currentColor"/>
    {%- when 'whatsapp' -%}<path d="M4 20l1.3-4A8 8 0 1 1 8 18.7L4 20Z"/><path d="M9 9c0 3 3 6 6 6l1-1.5-2-1-1 1c-1-.5-2-1.5-2.5-2.5l1-1-1-2L9 9Z"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>
  {%- endcase -%}
</svg>
