{{ form.errors | default_errors }}
<div class="field"><label class="label" for="AddrFirst-{{ id }}">{{ 'customer.first_name' | t }}</label><input class="input" id="AddrFirst-{{ id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
<div class="field"><label class="label" for="AddrLast-{{ id }}">{{ 'customer.last_name' | t }}</label><input class="input" id="AddrLast-{{ id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
<div class="field"><label class="label" for="Addr1-{{ id }}">Address</label><input class="input" id="Addr1-{{ id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
<div class="field"><label class="label" for="Addr2-{{ id }}">Apartment, suite, etc.</label><input class="input" id="Addr2-{{ id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
<div class="field"><label class="label" for="AddrCity-{{ id }}">City</label><input class="input" id="AddrCity-{{ id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
<div class="field"><label class="label" for="AddrCountry-{{ id }}">Country</label><select class="input select" id="AddrCountry-{{ id }}" name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select></div>
<div class="field"><label class="label" for="AddrProvince-{{ id }}">Province</label><input class="input" id="AddrProvince-{{ id }}" name="address[province]" value="{{ form.province }}" autocomplete="address-level1"></div>
<div class="field"><label class="label" for="AddrZip-{{ id }}">Postal code</label><input class="input" id="AddrZip-{{ id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
<div class="field"><label class="label" for="AddrPhone-{{ id }}">Phone</label><input class="input" type="tel" id="AddrPhone-{{ id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
<label class="option">{{ form.set_as_default_checkbox }} <span>{{ 'customer.default' | t }}</span></label>
