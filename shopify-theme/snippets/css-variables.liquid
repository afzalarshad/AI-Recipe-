{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_body_font
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
-%}
<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font_bold | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}

  :root {
    --color-bg: {{ settings.color_background }};
    --color-surface: {{ settings.color_surface }};
    --color-text: {{ settings.color_text }};
    --color-muted: {{ settings.color_text | color_mix: settings.color_background, 65 }};
    --color-border: {{ settings.color_text | color_mix: settings.color_background, 15 }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-contrast: {{ settings.color_accent_text }};
    --color-highlight: {{ settings.color_highlight }};
    --color-dark: {{ settings.color_dark }};
    --color-dark-text: {{ settings.color_dark_text }};
    --color-sale: {{ settings.color_sale }};

    --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-weight: {% if heading_font_bold %}{{ heading_font_bold.weight }}{% else %}{{ heading_font.weight }}{% endif %};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-bold: {% if body_font_bold %}{{ body_font_bold.weight }}{% else %}700{% endif %};
    --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

    --radius: {{ settings.radius }}px;
    --radius-button: {{ settings.button_radius }}px;
    --page-width: {{ settings.page_width }}px;
  }
</style>
